{
  "name": "power-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/bundle-server.mjs",
    "start": "node ./server/index.js",
